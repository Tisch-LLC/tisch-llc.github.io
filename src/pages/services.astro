  pageType="webpage"
  publishedAt="2020-06-15 13:00:00 +0900"
  modifiedAt="2026-10-19 13:00:00 +0900"
>
  <div class="columns">
    <div class="column is-10 is-offset-1">
      <div class="columns featured-post is-multiline">
        <div class="column is-12 post">
          <article class="columns featured">
            <div class="column is-6 post-img">
              <img
                class="responsive-image"
                src="/images/services.png"
                alt="デバイス"
                width="1000"
                height="694"
                loading="lazy"
              />
            </div>
            <div class="column is-6 featured-content va">
              <div>
                <h2 class="post-title">開発サービス</h2>
                <ul>
                  <li>
                    <a href="https://tobuhi.jp" target="_blank" rel="noreferrer noopener">とぶひ</a>
                    : 不動産会社向け「不動産の健康診断」SaaS（株式会社サカタ・しする株式会社と共同開発）
                  </li>
                  <li>
                    <a href="https://www.tellusxdp.com/" target="_blank" rel="noreferrer noopener">Tellus</a>
                    などを利用した衛星データ解析・機械学習モデル開発
